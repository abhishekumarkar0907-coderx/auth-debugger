# Authorization Debugger Frontend Configuration
#
# LOCAL DEVELOPMENT (Default):
# The frontend uses same-origin relative requests by default (VITE_API_BASE_URL="")
# so that Vite's dev proxy forwards both /api and /health to the backend target.
#
# Backend target used by Vite dev server proxy (defaults to http://localhost:8000):
VITE_BACKEND_TARGET=http://localhost:8000

# OPTIONAL OVERRIDE:
# Leave VITE_API_BASE_URL unset or empty for standard local Vite proxy development.
# If set to an absolute URL, the browser will send direct cross-origin requests,
# which requires CORS headers to be enabled on the target backend server.
# VITE_API_BASE_URL=
